{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link",
    "icon": "link"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true,
      "regex": "^(\\/|https?:\\/\\/|#)\\S*$"
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "accent",
        "dark",
        "outline",
        "text"
      ],
      "default": "accent"
    },
    "isExternal": {
      "type": "boolean",
      "default": false
    },  
    "highlight": {
        "type": "boolean",
        "default": false
      }
  },
  "config": {}
}
