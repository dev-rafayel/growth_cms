{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "Seo",
    "description": "Search engine and social sharing settings"
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "maxLength": 60,
      "required": true
    },
    "metaDescription": {
      "type": "text",
      "minLength": 50,
      "maxLength": 160,
      "required": true
    },
    "keywords": {
      "type": "string",
      "maxLength": 255
    },
    "ogTitle": {
      "type": "string",
      "maxLength": 90
    },
    "ogDescription": {
      "type": "text",
      "maxLength": 200
    },
    "shareImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "canonicalURL": {
      "type": "string",
      "regex": "^https?:\\/\\/\\S+$"
    },
    "noIndex": {
      "type": "boolean",
      "default": false
    },
    "noFollow": {
      "type": "boolean",
      "default": false
    }
  }
}
