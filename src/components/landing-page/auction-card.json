{
  "collectionName": "components_landing_page_auction_cards",
  "info": {
    "displayName": "Auction Card"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "category": {
      "type": "string",
      "required": true
    },
    "auctionUrl": {
      "type": "string",
      "required": true,
      "regex": "^(\\/|https?:\\/\\/)\\S*$"
    },
    "price": {
      "type": "decimal",
      "min": 0,
      "required": true
    },
    "bidCount": {
      "type": "integer",
      "min": 0
    },
    "endsAt": {
      "type": "datetime"
    },
    "listedAt": {
      "type": "datetime"
    }
  },
  "config": {}
}
