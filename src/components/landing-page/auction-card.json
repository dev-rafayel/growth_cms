{
  "collectionName": "auction-card",
  "info": {
    "displayName": "Auction Card"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "source": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "ending_soon",
        "newest"
      ]
    },
    "auctionDate": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "string",
      "required": true
    },
    "auctionUrl": {
      "type": "string",
      "required": true,
      "regex": "^(\\/|https?:\\/\\/)\\S*$"
    },
    "price": {
      "type": "string"
    }
  }
}